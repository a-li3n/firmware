FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV TZ=UTC
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Remove PEP 668 externally-managed marker — this is a build container,
# not a managed system. PlatformIO spawns subprocess pip installs that
# don't always respect --break-system-packages or the env var.
RUN rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED

# System build dependencies — Debian Trixie (13) to match Armbian targets
# that ship libgpiod 2.x (libgpiod.so.3), libyaml-cpp0.8, libjsoncpp26, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    cmake \
    pkg-config \
    git \
    curl \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    # Native radio / hardware libs (libgpiod 2.x in Trixie)
    libgpiod-dev \
    libi2c-dev \
    libbluetooth-dev \
    # Networking / async
    libuv1-dev \
    # Config / serialization
    libyaml-cpp-dev \
    libjsoncpp-dev \
    # HTTP / TLS (ulfius, openssl)
    libulfius-dev \
    libssl-dev \
    # Display (native-tft variant)
    libsdl2-dev \
    # BSD helpers
    libbsd-dev \
    # USB (ch341 userspace SPI library)
    libusb-1.0-0-dev \
    # Debian package building
    dpkg-dev \
    && rm -rf /var/lib/apt/lists/*

# PlatformIO CLI
RUN pip3 install --no-cache-dir --break-system-packages platformio

# Pre-cache the platform-native framework to avoid first-build download issues
RUN pio pkg install -g -p "https://github.com/meshtastic/platform-native/archive/61067ac3774e4fe27aa9762c72cebea507f116c8.zip" || true

WORKDIR /firmware
